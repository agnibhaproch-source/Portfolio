# Copy to .env.local (never commit real keys).

# Resend API key for the contact form (https://resend.com). Without it the
# form shows its "email me directly" fallback instead of sending.
RESEND_API_KEY=

# Public URL once the custom domain is live, e.g. https://agnibha.dev
# (used for share images, the sitemap and structured data). On Vercel it
# falls back to the production URL automatically.
NEXT_PUBLIC_SITE_URL=
